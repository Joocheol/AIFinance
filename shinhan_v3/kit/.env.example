# 이 파일을 복사해 이름을 .env 로 바꾸고 < > 부분을 채우세요.
# .env 는 비밀 파일입니다. 채팅에 붙여 넣거나 Claude에게 보여 달라고 하지 마세요.

# SEC 공정 접근 규칙: 자동으로 받는 프로그램은 연락처를 밝혀야 합니다 (실습: SEC 10월 수집)
SEC_CONTACT=<영문 이름> <이메일>

# 내 Azure PostgreSQL (실습: Azure에 내 DB 만들기)
PGHOST=<서버 이름>.postgres.database.azure.com
PGUSER=jpmadmin
PGPASSWORD=<서버를 만들 때 정한 비밀번호>
PGDATABASE=postgres

# 강사의 공용 상품 DB (읽기 전용, 모두 같은 값. 연세대 네트워크에서만 접속)
SHARED_HOST=jpm-shared-d32c.postgres.database.azure.com
SHARED_USER=student_ro
SHARED_PASSWORD=20261128
SHARED_DATABASE=jpm

# 내 Azure OpenAI 임베딩 (실습: 임베딩)
AOAI_ENDPOINT=https://<계정 이름>.openai.azure.com/
AOAI_KEY=<키 1>
AOAI_DEPLOYMENT=emb3s
